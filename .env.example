# TQ ChatBot #1 - Environment Variables
# Copy this file to .env and fill in the values for your environment.

# ============================================
# SECURITY NOTICE — READ FIRST
# ============================================
# Variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put API keys, webhook secrets, or service-role keys behind VITE_.
# Claude, n8n secret validation, and Supabase service-role writes
# MUST run through Supabase Edge Functions or server-side routes in production.
# The browser MVP uses safe stubs — no real secrets reach the client.

# ============================================
# CLIENT-SAFE (exposed to browser)
# ============================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_CALENDLY_URL=https://calendly.com/your-username/your-event-type

# ============================================
# SERVER-ONLY (never prefixed with VITE_)
# ============================================
# These belong in Supabase Edge Function secrets, .env.local,
# or your hosting provider's secret manager — NEVER in the client bundle.

# Claude API key — used by Edge Function /api/extract-signals
CLAUDE_API_KEY=

# n8n webhook URL and secret — used by Edge Function /api/n8n-dispatch
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Supabase service-role key — used by Edge Functions for privileged writes
# (lead alerts, followup_jobs, tenant admin). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# NOTES
# ============================================
# - Add .env, .env.local, and .env.*.local to your .gitignore
# - In production, store server-only secrets in your hosting provider's
#   secret manager (Supabase Dashboard → Settings → Edge Functions → Secrets)
# - The application works with safe in-memory stubs when no credentials are set
